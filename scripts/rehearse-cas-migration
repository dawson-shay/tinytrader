#!/usr/bin/env bash
# Rehearse the content-addressed migration (decisions 0035, 0039) end to end,
# on fake drives, before touching real ones: the runbook's exact sequence of
# `store migrate-cas --plan`, a migration per source, `tt-fsck`, `tt-fsck
# --against` each source, and reads by name with failover, asserting each
# exit status and finding.
#
#   scripts/rehearse-cas-migration [WORKDIR]
#
# WORKDIR (default: a new temporary folder) gets three sources laid out like
# Data, tt03 and NewDrive, an unmounted (empty) source, and two destination
# volumes. Nothing outside it is read or written. The binaries are `store`
# and `tt-fsck` on PATH, or STORE_BIN and FSCK_BIN. Needs bash, jq, curl and
# sha256sum (or shasum). Exit 0 when every step behaved as the runbook says;
# otherwise the first step that didn't, and why. With KEEP_GOING=1 every
# step runs and every one that didn't behave is listed (to show what an
# older build gets wrong).
set -euo pipefail

STORE_BIN=${STORE_BIN:-store}
FSCK_BIN=${FSCK_BIN:-tt-fsck}
for t in "$STORE_BIN" "$FSCK_BIN" jq curl; do
  command -v "$t" >/dev/null || { echo "rehearse: $t not found" >&2; exit 2; }
done
if command -v sha256sum >/dev/null; then sha() { sha256sum "$1" | cut -d' ' -f1; }
else sha() { shasum -a 256 "$1" | cut -d' ' -f1; }; fi

W=${1:-$(mktemp -d "${TMPDIR:-/tmp}/rehearse-cas.XXXXXX")}
mkdir -p "$W"
if [ -n "$(ls -A "$W")" ]; then echo "rehearse: $W isn't empty" >&2; exit 2; fi
W=$(cd "$W" && pwd -P)
LOG="$W/rehearsal.log"
STORE_PID=
cleanup() { [ -n "$STORE_PID" ] && kill "$STORE_PID" 2>/dev/null; true; }
trap cleanup EXIT

n=0
step() { n=$((n + 1)); printf '%2d. %s\n' "$n" "$*"; }
FAILED=()
fail() {
  echo "   FAILED at step $n: $*" >&2
  if [ "${KEEP_GOING:-}" = 1 ]; then
    case " ${FAILED[*]-} " in *" $n "*) ;; *) FAILED+=("$n") ;; esac
    return 0
  fi
  echo "   (outputs in $W)" >&2; exit 1
}
# expect STATUS OUTFILE CMD...: run it, its stdout to OUTFILE, and check its exit status.
expect() {
  local want=$1 out=$2; shift 2
  local got=0
  "$@" >"$out" 2>>"$LOG" || got=$?
  [ "$got" = "$want" ] || fail "$* exited $got, not $want (stdout in $out)"
  return 0
}
# has FILE JQ-FILTER WHY: the JSON in FILE satisfies the filter.
has() { jq -e "$2" "$1" >/dev/null 2>&1 || fail "$3 ($1: $2)"; }

put() { mkdir -p "$(dirname "$1")"; printf '%s' "$2" >"$1"; }

DAYS=Databento/OPRA.PILLAR/SPY.OPT/cbbo-1m
step "fake drives in $W"
# Data: the original archive. Days, a manifest, a batch's receipt, a ledger
# written when it was mounted at /Volumes/Data, an upload never filed, a
# zero-byte marker and the OS's own files.
D=$W/src/data
put "$D/$DAYS/2022-09-07.dbn.zst" "the seventh, as filed"
put "$D/$DAYS/2022-09-08.dbn.zst" "the eighth, version A"
put "$D/$DAYS/manifest.json" '{"schema":"tinytrader.store-manifest/1","days":{}}'
put "$D/Databento/provenance/OPRA-20220908-X/manifest.json" '{"files":[]}'
put "$D/Databento/.incoming/OPRA-20251112-Y/opra-pillar-20251112.tcbbo.dbn.zst" "an upload never filed"
put "$D/Databento/.incoming/OPRA-20251112-Y/REQUESTED" ""
put "$D/.DS_Store" "finder"
# OS-like names below the root are data, copied and checked; the OS's own
# folder at the root is skipped, and listed.
put "$D/Databento/x/._notes.dbn.zst" "not apple's"
put "$D/lost+found/#1234" "recovered by fsck"
put "$D/Databento/y/.Trashes/kept" "a folder named like the OS's"
put "$D/.Trashes/501/deleted" "the user's trash"
SEVENTH=$(sha "$D/$DAYS/2022-09-07.dbn.zst")
mkdir -p "$D/Databento/migrations"
jq -nc --arg to "/Volumes/Data/$DAYS/2022-09-07.dbn.zst" --arg sha "$SEVENTH" \
  '{step:"moved", from:"/Volumes/Data/Databento/.incoming/OPRA-X/opra-pillar-20220907.cbbo-1m.dbn.zst", to:$to, sha256:$sha}' \
  >"$D/Databento/migrations/2022-09-08-incorporate-OPRA-X.events.jsonl"
# tt03: the seventh again (a duplicate), the eighth with other bytes at the
# same size (a conflict), a day of its own, and an empty marker of another
# kind (same hash as Data's).
T=$W/src/tt03
put "$T/$DAYS/2022-09-07.dbn.zst" "the seventh, as filed"
put "$T/$DAYS/2022-09-08.dbn.zst" "the eighth, version B"
put "$T/$DAYS/2023-01-03.dbn.zst" "only on tt03"
put "$T/Databento/cache/OPRA-K1/COMPLETE.json" ""
# NewDrive: another provider's days.
N=$W/src/newdrive
put "$N/Alpaca/UVXY/2026-06-19.definitions.dbn.zst" "uvxy definitions"
# A drive not mounted: its mount point, empty.
mkdir -p "$W/src/unmounted"
NAS=$W/nas/tt04
NAS2=$W/nas/second

DATA_FILES=$(cd "$D" && find . -type f -not -path './.Trashes/*' | wc -l | tr -d ' ')
step "migrate-cas --plan, all three sources: writes nothing, exit 0"
expect 0 "$W/plan.json" "$STORE_BIN" migrate-cas --plan --to "$NAS" --id tt04 \
  --from data="$D" --from tt03="$T" --from newdrive="$N"
has "$W/plan.json" ".names == $((DATA_FILES + 3)) and .on_several_sources == 2 and (.os_files_skipped | length) == 1 and (.os_files_skipped[0] | endswith(\".Trashes\"))" "the plan's counts"
[ ! -e "$NAS" ] || fail "the plan wrote the destination"

step "migrate-cas --plan with the unmounted source: refused, exit 2"
expect 2 "$W/plan-unmounted.json" "$STORE_BIN" migrate-cas --plan --from unmounted="$W/src/unmounted"

step "migrate Data: exit 0, everything bound, its ledger's hash used from another mount point"
expect 0 "$W/migrate-data.json" "$STORE_BIN" migrate-cas --to "$NAS" --id tt04 --from data="$D"
has "$W/migrate-data.json" ".ok and .bound == $DATA_FILES and (.damaged | length) == 0 and .without_a_recorded_hash == $((DATA_FILES - 1))" "Data's migration"

step "migrate tt03: exit 1, the eighth's other version kept as a conflict, not bound"
expect 1 "$W/migrate-tt03.json" "$STORE_BIN" migrate-cas --to "$NAS" --id tt04 --from tt03="$T"
has "$W/migrate-tt03.json" '(.conflicts | length) == 1 and (.conflicts[0].name | endswith("2022-09-08.dbn.zst")) and .kept_pending == 1 and .bound == 2' "tt03's conflict"

step "migrate NewDrive: exit 0"
expect 0 "$W/migrate-newdrive.json" "$STORE_BIN" migrate-cas --to "$NAS" --id tt04 --from newdrive="$N"

step "migrate the unmounted source: refused, exit 2, nothing written for it"
expect 2 "$W/migrate-unmounted.json" "$STORE_BIN" migrate-cas --to "$NAS" --id tt04 --from unmounted="$W/src/unmounted"
[ ! -e "$NAS/cas/sources/unmounted.json" ] || fail "a receipt was written for the unmounted source"

step "migrate Data again: resumes, nothing read again or written"
expect 0 "$W/migrate-data-2.json" "$STORE_BIN" migrate-cas --to "$NAS" --id tt04 --from data="$D"
has "$W/migrate-data-2.json" ".bound == 0 and .bytes_written == 0 and .already_there == $DATA_FILES" "the resume"

step "tt-fsck: exit 1, since tt03's migration didn't end clean"
expect 1 "$W/fsck.json" "$FSCK_BIN" --json --min-copies 1 "$NAS"
has "$W/fsck.json" '[.findings[] | select(.rule == "S6" and (.finding | startswith("migration from tt03")))] | length == 1' "the unclean receipt"
has "$W/fsck.json" '[.findings[] | select(.rule == "S1" or .rule == "S2")] | length == 0' "no S1/S2 findings on a sound volume"

step "tt-fsck --quick says it's not a gate"
expect 1 "$W/fsck-quick.txt" "$FSCK_BIN" --quick --min-copies 1 "$NAS"
head -1 "$W/fsck-quick.txt" | grep -q '^QUICK CHECK' || fail "--quick doesn't say so"

step "tt-fsck --against Data: every Data file held (only tt03's receipt is a finding)"
expect 1 "$W/against-data.json" "$FSCK_BIN" --json --min-copies 1 --against data="$D" "$NAS"
has "$W/against-data.json" ".against[0].files == $DATA_FILES and .against[0].bound == $DATA_FILES and (.against[0].skipped | length) == 1 and ([.findings[] | select(.volume == \"data\")] | length) == 0" "Data held whole, OS-like names included, the root .Trashes listed"

step "tt-fsck --against tt03: its eighth is kept as pending, not bound: an operator's choice"
expect 1 "$W/against-tt03.json" "$FSCK_BIN" --json --min-copies 1 --against tt03="$T" "$NAS"
has "$W/against-tt03.json" '[.findings[] | select(.volume == "tt03" and (.finding | contains("2022-09-08.dbn.zst")) and (.finding | contains("kept as pending")))] | length == 1' "tt03's conflict at the gate"

step "tt-fsck --against the unmounted source: refused, exit 2"
expect 2 "$W/against-unmounted.json" "$FSCK_BIN" --json --min-copies 1 --against unmounted="$W/src/unmounted" "$NAS"

step "a changed source fails the gate"
cp -R "$N" "$W/src/newdrive-changed"
put "$W/src/newdrive-changed/Alpaca/UVXY/2026-06-19.definitions.dbn.zst" "uvxy definitionz"
expect 1 "$W/against-changed.json" "$FSCK_BIN" --json --min-copies 1 --against newdrive="$W/src/newdrive-changed" "$NAS"
has "$W/against-changed.json" '[.findings[] | select(.volume == "newdrive" and (.finding | contains("not held")))] | length == 1' "the changed file"

step "a damaged object fails tt-fsck (S1)"
cp -R "$NAS" "$W/nas/damaged"
OBJ=$(find "$W/nas/damaged/cas/objects" -name "$SEVENTH.*" | head -1)
chmod u+w "$OBJ"; printf 'the seventh, as filez' >"$OBJ"
expect 1 "$W/fsck-damaged.json" "$FSCK_BIN" --json --min-copies 1 "$W/nas/damaged"
has "$W/fsck-damaged.json" '[.findings[] | select(.rule == "S1" and (.finding | contains("hashes to")))] | length >= 1' "the damage"
rm -rf "$W/nas/damaged"

step "a cp -p clone of Data under the same name, one file rewritten with its time restored: exit 1, a conflict"
cp -R "$NAS" "$W/nas/clone-dest"
cp -Rp "$D" "$W/src/data-clone"
F="$W/src/data-clone/$DAYS/2022-09-08.dbn.zst"
cp -p "$F" "$W/f.orig"; printf 'the eighth, version Z' >"$F"; touch -r "$W/f.orig" "$F"
expect 1 "$W/migrate-clone.json" "$STORE_BIN" migrate-cas --to "$W/nas/clone-dest" --id tt04 --from data="$W/src/data-clone"
has "$W/migrate-clone.json" '(.conflicts | length) == 1 and (.conflicts[0].name | endswith("2022-09-08.dbn.zst")) and .bound == 0' "the restored-time rewrite"
rm -rf "$W/nas/clone-dest"

step "a pending object deleted (a conflict's only other copy): tt-fsck exit 1"
cp -R "$NAS" "$W/nas/pending-gone"
B=$(jq -r '.conflicts[0].copies[]? | select(.source == "tt03") | .sha256' "$W/migrate-tt03.json" 2>/dev/null || true)
P=$( [ -n "$B" ] && find "$W/nas/pending-gone/cas/objects" -name "$B.*" | head -1 || true)
[ -n "$P" ] || fail "tt03's pending object isn't there to delete"
[ -n "$P" ] && { chmod u+w "$P"; rm -f "$P"; }
expect 1 "$W/fsck-pending-gone.json" "$FSCK_BIN" --json --min-copies 1 "$W/nas/pending-gone"
has "$W/fsck-pending-gone.json" '[.findings[] | select(.rule == "S1" and (.finding | contains("pending object")))] | length == 1' "the missing pending object"
rm -rf "$W/nas/pending-gone"

step "a date flipped inside a bind line: the log fails its checksum, tt-fsck exit 2"
cp -R "$NAS" "$W/nas/edited"
L="$W/nas/edited/cas/index/bindings.jsonl"
chmod u+w "$L"
awk 'done || !/"event":"bind"/ || !/2022-09-07/ { print; next } { sub(/2022-09-07/, "2022-09-06"); print; done = 1 }' "$L" >"$L.new" && mv "$L.new" "$L"
expect 2 "$W/fsck-edited.json" "$FSCK_BIN" --json --min-copies 1 "$W/nas/edited"
has "$W/fsck-edited.json" '[.unreadable[] | select(contains("fails its checksum"))] | length == 1' "the edited line"
rm -rf "$W/nas/edited"

step "review C3: an empty .bin object gone beside an empty .json one (same hash): tt-fsck exit 1"
cp -R "$NAS" "$W/nas/empty-gone"
E=$(find "$W/nas/empty-gone/cas/objects" -name 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855.bin' | head -1)
[ -n "$E" ] || fail "no empty .bin object (Data's REQUESTED marker) to delete"
[ -n "$E" ] && { chmod u+w "$E"; rm -f "$E"; }
expect 1 "$W/fsck-empty-gone.json" "$FSCK_BIN" --json --min-copies 1 "$W/nas/empty-gone"
has "$W/fsck-empty-gone.json" '[.findings[] | select(.rule == "S1" and (.finding | contains("REQUESTED")))] | length == 1' "the missing empty marker"
rm -rf "$W/nas/empty-gone"

step "review H2: a day whose size isn't its manifest's: exit 1, kept, not bound"
M=$W/src/mismatch
put "$M/$DAYS/2022-09-09.dbn.zst" "short"
put "$M/$DAYS/manifest.json" '{"schema":"tinytrader.store-manifest/1","days":{"2022-09-09":{"file":"2022-09-09.dbn.zst","size":999}}}'
expect 1 "$W/migrate-mismatch.json" "$STORE_BIN" migrate-cas --to "$W/nas/mismatch" --id mm --from mismatch="$M"
has "$W/migrate-mismatch.json" '([.damaged[] | select(contains("2022-09-09") and contains("999"))] | length) == 1 and .bound == 1' "the size mismatch kept, not bound (only the manifest bound)"

step "review H4: an edited snapshot (two names' hashes swapped): tt-fsck exit 1"
"$FSCK_BIN" --min-copies 1 "$NAS" >/dev/null 2>&1 || true
cp -R "$NAS" "$W/nas/snap"
S="$W/nas/snap/cas/index/snapshot.json"
EIGHTH=$(sha "$D/$DAYS/2022-09-08.dbn.zst")
if [ -f "$S" ]; then
  chmod u+w "$S"
  sed -e "s/$SEVENTH/TMPHASH/g" -e "s/$EIGHTH/$SEVENTH/g" -e "s/TMPHASH/$EIGHTH/g" "$S" >"$S.new" && mv "$S.new" "$S"
else fail "no snapshot to edit"; fi
expect 1 "$W/fsck-snap.json" "$FSCK_BIN" --json --min-copies 1 "$W/nas/snap"
has "$W/fsck-snap.json" '[.findings[] | select(.finding | startswith("snapshot"))] | length == 1' "the edited snapshot"
rm -rf "$W/nas/snap"

# A store over these volumes on a free port, until stop_store.
start_store() {
  PORT=$((20000 + RANDOM % 20000))
  local args=()
  for v in "$@"; do args+=(--volume "$v"); done
  STORE_LISTEN=127.0.0.1:$PORT "$STORE_BIN" "${args[@]}" \
    --state "$W/store-state-$PORT.json" --rescan-seconds 1 >>"$LOG" 2>&1 &
  STORE_PID=$!
  URL=http://127.0.0.1:$PORT
  for _ in $(seq 100); do
    curl -sf "$URL/batches/databento" >/dev/null 2>&1 && break
    sleep 0.2
  done
}
stop_store() { kill "$STORE_PID" 2>/dev/null; wait "$STORE_PID" 2>/dev/null || true; STORE_PID=; }
COV="/coverage?provider=databento&dataset=OPRA.PILLAR&symbol=SPY.OPT&schema=cbbo-1m&start=2022-09-07&end=2022-09-08"
# Days as /coverage gives them, without where they are.
days_of() { jq -S '[.days[] | del(.volume, .volumes, .path, .paths, .files, .file, .copies)]' "$1"; }
filed_of() { jq -S '[.batches | to_entries[] | select(.value.how == "filed") | .key] | sort' "$1"; }
# Every batch and how it's held (filed, incoming, folder), restricted to the ids in $2 if given.
how_of() { jq -S --argjson ids "${2:-null}" '.batches | to_entries | map(select($ids == null or (.key as $k | $ids | index($k)))) | map({(.key): .value.how}) | add // {}' "$1"; }

step "the source's answers: a store over Data's tree (read-only)"
start_store "data=$D:ro:anydir"
curl -s "$URL/batches/databento" >"$W/batches-before.json"
curl -s "$URL$COV" >"$W/coverage-before.json"
stop_store
has "$W/batches-before.json" '.missing_volumes == [] and (.batches | to_entries | map(select(.value.how == "filed")) | length) == 1 and (.batches | length) == 2' "Data's batches: one filed, one waiting"
has "$W/coverage-before.json" '(.days | length) == 2' "Data's two SPY days"

step "the migrated volume answers the same: /batches lists Data's batches filed, /coverage the same days"
start_store "tt04=$NAS:ro:anydir"
curl -s "$URL/batches/databento" >"$W/batches-after.json"
curl -s "$URL$COV" >"$W/coverage-after.json"
stop_store
has "$W/batches-after.json" '.missing_volumes == []' "no volume missing after"
IDS=$(jq -c '.batches | keys' "$W/batches-before.json")
[ "$(how_of "$W/batches-before.json" | jq -c .)" = "$(how_of "$W/batches-after.json" "$IDS" | jq -c .)" ] \
  || fail "the migrated volume doesn't hold Data's batches as the tree did (filed and waiting alike)"
[ "$(days_of "$W/coverage-before.json" | jq -c .)" = "$(days_of "$W/coverage-after.json" | jq -c .)" ] \
  || fail "the migrated volume's /coverage days differ from the tree's"

step "two drives sharing a folder (different manifests), a lowercase provider, a download folder, a waiting upload, an empty receipt folder: the same answers after"
PA=$W/src/pair-a; PB=$W/src/pair-b
put "$PA/$DAYS/2026-10-01.dbn.zst" "a degraded day"
put "$PA/$DAYS/manifest.json" '{"schema":"tinytrader.store-manifest/1","days":{"2026-10-01":{"condition":{"state":"degraded","reason":"x"}}}}'
put "$PA/OPRA-DL-1/metadata.json" '{"query":{"dataset":"OPRA.PILLAR","schema":"tcbbo","symbols":["SPY.OPT"],"start":"2026-10-01","end":"2026-10-02"}}'
put "$PA/OPRA-DL-1/manifest.json" '{}'
put "$PA/OPRA-DL-1/opra-pillar-20261001.tcbbo.dbn.zst" "downloaded"
LOWER=databento/OPRA.PILLAR/SPY.OPT/cbbo-1m
put "$PB/$LOWER/2026-10-02.dbn.zst" "a later day"
put "$PB/$LOWER/manifest.json" '{"schema":"tinytrader.store-manifest/1","days":{"2026-10-02":{"condition":{"state":"missing","reason":"y"}}}}'
put "$PB/databento/provenance/OPRA-FILED-2/manifest.json" '{}'
mkdir -p "$PB/databento/provenance/OPRA-EMPTY-4"
put "$PB/databento/.incoming/OPRA-IN-3/x.dbn.zst" "waiting"
PCOV="/coverage?provider=databento&dataset=OPRA.PILLAR&symbol=SPY.OPT&schema=cbbo-1m&start=2026-10-01&end=2026-10-02"
start_store "a=$PA:ro:anydir" "b=$PB:ro:anydir"
curl -s "$URL/batches/databento" >"$W/pair-batches-before.json"
curl -s "$URL$PCOV" >"$W/pair-coverage-before.json"
stop_store
expect 0 "$W/pair-plan.json" "$STORE_BIN" migrate-cas --plan --to "$W/nas/pair" --id pair --from a="$PA" --from b="$PB"
has "$W/pair-plan.json" '(.manifests.merged | length) == 1 and (.manifests.day_conflicts | length) == 0' "the plan counts the folder's manifests to merge, no day in conflict"
expect 0 "$W/pair-migrate-a.json" "$STORE_BIN" migrate-cas --to "$W/nas/pair" --id pair --from a="$PA"
expect 0 "$W/pair-migrate-b.json" "$STORE_BIN" migrate-cas --to "$W/nas/pair" --id pair --from b="$PB"
start_store "pair=$W/nas/pair:ro:anydir"
curl -s "$URL/batches/databento" >"$W/pair-batches-after.json"
curl -s "$URL$PCOV" >"$W/pair-coverage-after.json"
stop_store
has "$W/pair-batches-before.json" '(.batches | length) == 4' "four batches in the trees"
[ "$(how_of "$W/pair-batches-before.json" | jq -c .)" = "$(how_of "$W/pair-batches-after.json" | jq -c .)" ] \
  || fail "the batches differ after the migration (filed, waiting, download folder, empty receipt folder)"
has "$W/pair-coverage-before.json" '(.days | length) == 2' "two days in the trees"
[ "$(days_of "$W/pair-coverage-before.json" | jq -c .)" = "$(days_of "$W/pair-coverage-after.json" | jq -c .)" ] \
  || fail "the days differ after the migration (a degraded day on one drive, a missing one on the other)"
expect 0 "$W/pair-against-b.json" "$FSCK_BIN" --json --min-copies 1 --against b="$PB" "$W/nas/pair"
has "$W/pair-against-b.json" '.against[0].bound == .against[0].files' "every file of the lowercase drive held, its manifest merged"

step "an object gone from the migrated volume: the store reports the volume missing (downloads hold), every scan"
cp -R "$NAS" "$W/nas/gone"
G=$(find "$W/nas/gone/cas/objects" -name "$SEVENTH.*" | head -1)
[ -n "$G" ] || fail "no object of the seventh to remove"
[ -n "$G" ] && { chmod u+w "$G"; rm -f "$G"; }
start_store "gone=$W/nas/gone:ro:anydir"
curl -s "$URL/batches/databento" >"$W/gone-batches-1.json"
sleep 2
curl -s "$URL/batches/databento" >"$W/gone-batches-2.json"
stop_store
has "$W/gone-batches-1.json" '.missing_volumes == ["gone"]' "the volume missing on the first scan"
has "$W/gone-batches-2.json" '.missing_volumes == ["gone"]' "and on later scans"
rm -rf "$W/nas/gone"

step "a second copy: Data migrated to another volume; both checked together, two copies"
expect 0 "$W/migrate-second.json" "$STORE_BIN" migrate-cas --to "$NAS2" --id second --from data="$D"
expect 1 "$W/fsck-two.json" "$FSCK_BIN" --json --min-copies 2 "$NAS" "$NAS2"
has "$W/fsck-two.json" '[.findings[] | select(.rule == "S7" and (.finding | contains("2022-09-07.dbn.zst")))] | length == 0' "the seventh has two copies"

step "the store reads by name, with its recorded hash"
PORT=$((20000 + RANDOM % 20000))
STORE_LISTEN=127.0.0.1:$PORT "$STORE_BIN" \
  --volume "tt04=$NAS:ro:anydir" --volume "second=$NAS2:ro:anydir" \
  --state "$W/store-state.json" --rescan-seconds 1 >>"$LOG" 2>&1 &
STORE_PID=$!
URL=http://127.0.0.1:$PORT
for _ in $(seq 100); do
  curl -sf "$URL/files?pattern=*2022-09-07*" >/dev/null 2>&1 && break
  sleep 0.2
done
NAME=$DAYS/2022-09-07.dbn.zst
read_file() { curl -s -D "$W/headers" -o "$W/body" -w '%{http_code}' "$URL/files/$1/$NAME"; }
[ "$(read_file tt04)" = 200 ] || fail "reading tt04/$NAME"
grep -qi "x-content-sha256: $SEVENTH" "$W/headers" || fail "no recorded hash header"
[ "$(sha "$W/body")" = "$SEVENTH" ] || fail "the bytes read aren't the seventh's"

step "failover: tt04 removed, the same name read from the second copy"
mv "$NAS" "$W/nas/tt04-away"
sleep 2
[ "$(read_file tt04)" = 200 ] || fail "no failover to the second copy"
[ "$(sha "$W/body")" = "$SEVENTH" ] || fail "failover served other bytes"

step "with no copy left, 503 (never 404)"
mv "$NAS2" "$W/nas/second-away"
sleep 2
[ "$(read_file tt04)" = 503 ] || fail "no 503 with every copy gone"
kill "$STORE_PID"; wait "$STORE_PID" 2>/dev/null || true; STORE_PID=
mv "$W/nas/tt04-away" "$NAS"; mv "$W/nas/second-away" "$NAS2"

step "every source is as it was"
[ "$(sha "$D/$DAYS/2022-09-07.dbn.zst")" = "$SEVENTH" ] || fail "Data was changed"
[ "$(cat "$T/$DAYS/2022-09-08.dbn.zst")" = "the eighth, version B" ] || fail "tt03 was changed"

if [ "${#FAILED[@]}" -gt 0 ]; then
  echo "rehearsal FAILED: steps ${FAILED[*]} of $n (outputs and log in $W)"
  exit 1
fi
echo "rehearsal passed: $n steps (outputs and log in $W)"
