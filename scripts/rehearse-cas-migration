#!/usr/bin/env bash
# Rehearse the content-addressed migration (decisions 0035, 0039) end to end,
# on fake drives, before touching real ones: the runbook's exact sequence of
# `store migrate-cas --plan`, a migration per source, `tt-fsck`, `tt-fsck
# --against` each source, and reads by name with failover, asserting each
# exit status and finding.
#
#   scripts/rehearse-cas-migration [WORKDIR]
#
# WORKDIR (default: a new temporary folder) gets three sources laid out like
# Data, tt03 and NewDrive, an unmounted (empty) source, and two destination
# volumes. Nothing outside it is read or written. The binaries are `store`
# and `tt-fsck` on PATH, or STORE_BIN and FSCK_BIN. Needs bash, jq, curl and
# sha256sum (or shasum). Exit 0 when every step behaved as the runbook says;
# otherwise the first step that didn't, and why.
set -euo pipefail

STORE_BIN=${STORE_BIN:-store}
FSCK_BIN=${FSCK_BIN:-tt-fsck}
for t in "$STORE_BIN" "$FSCK_BIN" jq curl; do
  command -v "$t" >/dev/null || { echo "rehearse: $t not found" >&2; exit 2; }
done
if command -v sha256sum >/dev/null; then sha() { sha256sum "$1" | cut -d' ' -f1; }
else sha() { shasum -a 256 "$1" | cut -d' ' -f1; }; fi

W=${1:-$(mktemp -d "${TMPDIR:-/tmp}/rehearse-cas.XXXXXX")}
mkdir -p "$W"
if [ -n "$(ls -A "$W")" ]; then echo "rehearse: $W isn't empty" >&2; exit 2; fi
W=$(cd "$W" && pwd -P)
LOG="$W/rehearsal.log"
STORE_PID=
cleanup() { [ -n "$STORE_PID" ] && kill "$STORE_PID" 2>/dev/null; true; }
trap cleanup EXIT

n=0
step() { n=$((n + 1)); printf '%2d. %s\n' "$n" "$*"; }
fail() { echo "FAILED at step $n: $*" >&2; echo "   (outputs in $W)" >&2; exit 1; }
# expect STATUS OUTFILE CMD...: run it, its stdout to OUTFILE, and check its exit status.
expect() {
  local want=$1 out=$2; shift 2
  local got=0
  "$@" >"$out" 2>>"$LOG" || got=$?
  [ "$got" = "$want" ] || fail "$* exited $got, not $want (stdout in $out)"
}
# has FILE JQ-FILTER WHY: the JSON in FILE satisfies the filter.
has() { jq -e "$2" "$1" >/dev/null || fail "$3 ($1: $2)"; }

put() { mkdir -p "$(dirname "$1")"; printf '%s' "$2" >"$1"; }

DAYS=Databento/OPRA.PILLAR/SPY.OPT/cbbo-1m
step "fake drives in $W"
# Data: the original archive. Days, a manifest, a batch's receipt, a ledger
# written when it was mounted at /Volumes/Data, an upload never filed, a
# zero-byte marker and the OS's own files.
D=$W/src/data
put "$D/$DAYS/2022-09-07.dbn.zst" "the seventh, as filed"
put "$D/$DAYS/2022-09-08.dbn.zst" "the eighth, version A"
put "$D/$DAYS/manifest.json" '{"schema":"tinytrader.store-manifest/1","days":{}}'
put "$D/Databento/provenance/OPRA-20220908-X/manifest.json" '{"files":[]}'
put "$D/Databento/.incoming/OPRA-20251112-Y/opra-pillar-20251112.tcbbo.dbn.zst" "an upload never filed"
put "$D/Databento/.incoming/OPRA-20251112-Y/REQUESTED" ""
put "$D/.DS_Store" "finder"
SEVENTH=$(sha "$D/$DAYS/2022-09-07.dbn.zst")
mkdir -p "$D/Databento/migrations"
jq -nc --arg to "/Volumes/Data/$DAYS/2022-09-07.dbn.zst" --arg sha "$SEVENTH" \
  '{step:"moved", from:"/Volumes/Data/Databento/.incoming/OPRA-X/opra-pillar-20220907.cbbo-1m.dbn.zst", to:$to, sha256:$sha}' \
  >"$D/Databento/migrations/2022-09-08-incorporate-OPRA-X.events.jsonl"
# tt03: the seventh again (a duplicate), the eighth with other bytes at the
# same size (a conflict), a day of its own, and an empty marker of another
# kind (same hash as Data's).
T=$W/src/tt03
put "$T/$DAYS/2022-09-07.dbn.zst" "the seventh, as filed"
put "$T/$DAYS/2022-09-08.dbn.zst" "the eighth, version B"
put "$T/$DAYS/2023-01-03.dbn.zst" "only on tt03"
put "$T/Databento/cache/OPRA-K1/COMPLETE.json" ""
# NewDrive: another provider's days.
N=$W/src/newdrive
put "$N/Alpaca/UVXY/2026-06-19.definitions.dbn.zst" "uvxy definitions"
# A drive not mounted: its mount point, empty.
mkdir -p "$W/src/unmounted"
NAS=$W/nas/tt04
NAS2=$W/nas/second

step "migrate-cas --plan, all three sources: writes nothing, exit 0"
expect 0 "$W/plan.json" "$STORE_BIN" migrate-cas --plan --to "$NAS" --id tt04 \
  --from data="$D" --from tt03="$T" --from newdrive="$N"
has "$W/plan.json" '.names == 10 and .on_several_sources == 2 and (.os_files_skipped | length) == 1' "the plan's counts"
[ ! -e "$NAS" ] || fail "the plan wrote the destination"

step "migrate-cas --plan with the unmounted source: refused, exit 2"
expect 2 "$W/plan-unmounted.json" "$STORE_BIN" migrate-cas --plan --from unmounted="$W/src/unmounted"

step "migrate Data: exit 0, everything bound, its ledger's hash used from another mount point"
expect 0 "$W/migrate-data.json" "$STORE_BIN" migrate-cas --to "$NAS" --id tt04 --from data="$D"
has "$W/migrate-data.json" '.ok and .bound == 7 and (.damaged | length) == 0 and .without_a_recorded_hash == 6' "Data's migration"

step "migrate tt03: exit 1, the eighth's other version kept as a conflict, not bound"
expect 1 "$W/migrate-tt03.json" "$STORE_BIN" migrate-cas --to "$NAS" --id tt04 --from tt03="$T"
has "$W/migrate-tt03.json" '(.conflicts | length) == 1 and (.conflicts[0].name | endswith("2022-09-08.dbn.zst")) and .kept_pending == 1 and .bound == 2' "tt03's conflict"

step "migrate NewDrive: exit 0"
expect 0 "$W/migrate-newdrive.json" "$STORE_BIN" migrate-cas --to "$NAS" --id tt04 --from newdrive="$N"

step "migrate the unmounted source: refused, exit 2, nothing written for it"
expect 2 "$W/migrate-unmounted.json" "$STORE_BIN" migrate-cas --to "$NAS" --id tt04 --from unmounted="$W/src/unmounted"
[ ! -e "$NAS/cas/sources/unmounted.json" ] || fail "a receipt was written for the unmounted source"

step "migrate Data again: resumes, nothing read again or written"
expect 0 "$W/migrate-data-2.json" "$STORE_BIN" migrate-cas --to "$NAS" --id tt04 --from data="$D"
has "$W/migrate-data-2.json" '.bound == 0 and .bytes_written == 0 and .already_there == 7' "the resume"

step "tt-fsck: exit 1, since tt03's migration didn't end clean"
expect 1 "$W/fsck.json" "$FSCK_BIN" --json --min-copies 1 "$NAS"
has "$W/fsck.json" '[.findings[] | select(.rule == "S6" and (.finding | startswith("migration from tt03")))] | length == 1' "the unclean receipt"
has "$W/fsck.json" '[.findings[] | select(.rule == "S1" or .rule == "S2")] | length == 0' "no S1/S2 findings on a sound volume"

step "tt-fsck --quick says it's not a gate"
expect 1 "$W/fsck-quick.txt" "$FSCK_BIN" --quick --min-copies 1 "$NAS"
head -1 "$W/fsck-quick.txt" | grep -q '^QUICK CHECK' || fail "--quick doesn't say so"

step "tt-fsck --against Data: every Data file held (only tt03's receipt is a finding)"
expect 1 "$W/against-data.json" "$FSCK_BIN" --json --min-copies 1 --against data="$D" "$NAS"
has "$W/against-data.json" '.against[0].files == 7 and .against[0].bound == 7 and ([.findings[] | select(.volume == "data")] | length) == 0' "Data held whole"

step "tt-fsck --against tt03: its eighth is kept as pending, not bound: an operator's choice"
expect 1 "$W/against-tt03.json" "$FSCK_BIN" --json --min-copies 1 --against tt03="$T" "$NAS"
has "$W/against-tt03.json" '[.findings[] | select(.volume == "tt03" and (.finding | contains("2022-09-08.dbn.zst")) and (.finding | contains("kept as pending")))] | length == 1' "tt03's conflict at the gate"

step "tt-fsck --against the unmounted source: refused, exit 2"
expect 2 "$W/against-unmounted.json" "$FSCK_BIN" --json --min-copies 1 --against unmounted="$W/src/unmounted" "$NAS"

step "a changed source fails the gate"
cp -R "$N" "$W/src/newdrive-changed"
put "$W/src/newdrive-changed/Alpaca/UVXY/2026-06-19.definitions.dbn.zst" "uvxy definitionz"
expect 1 "$W/against-changed.json" "$FSCK_BIN" --json --min-copies 1 --against newdrive="$W/src/newdrive-changed" "$NAS"
has "$W/against-changed.json" '[.findings[] | select(.volume == "newdrive" and (.finding | contains("not held")))] | length == 1' "the changed file"

step "a damaged object fails tt-fsck (S1)"
cp -R "$NAS" "$W/nas/damaged"
OBJ=$(find "$W/nas/damaged/cas/objects" -name "$SEVENTH.*" | head -1)
chmod u+w "$OBJ"; printf 'the seventh, as filez' >"$OBJ"
expect 1 "$W/fsck-damaged.json" "$FSCK_BIN" --json --min-copies 1 "$W/nas/damaged"
has "$W/fsck-damaged.json" '[.findings[] | select(.rule == "S1" and (.finding | contains("hashes to")))] | length >= 1' "the damage"
rm -rf "$W/nas/damaged"

step "a second copy: Data migrated to another volume; both checked together, two copies"
expect 0 "$W/migrate-second.json" "$STORE_BIN" migrate-cas --to "$NAS2" --id second --from data="$D"
expect 1 "$W/fsck-two.json" "$FSCK_BIN" --json --min-copies 2 "$NAS" "$NAS2"
has "$W/fsck-two.json" '[.findings[] | select(.rule == "S7" and (.finding | contains("2022-09-07.dbn.zst")))] | length == 0' "the seventh has two copies"

step "the store reads by name, with its recorded hash"
PORT=$((20000 + RANDOM % 20000))
STORE_LISTEN=127.0.0.1:$PORT "$STORE_BIN" \
  --volume "tt04=$NAS:ro:anydir" --volume "second=$NAS2:ro:anydir" \
  --state "$W/store-state.json" --rescan-seconds 1 >>"$LOG" 2>&1 &
STORE_PID=$!
URL=http://127.0.0.1:$PORT
for _ in $(seq 100); do
  curl -sf "$URL/files?pattern=*2022-09-07*" >/dev/null 2>&1 && break
  sleep 0.2
done
NAME=$DAYS/2022-09-07.dbn.zst
read_file() { curl -s -D "$W/headers" -o "$W/body" -w '%{http_code}' "$URL/files/$1/$NAME"; }
[ "$(read_file tt04)" = 200 ] || fail "reading tt04/$NAME"
grep -qi "x-content-sha256: $SEVENTH" "$W/headers" || fail "no recorded hash header"
[ "$(sha "$W/body")" = "$SEVENTH" ] || fail "the bytes read aren't the seventh's"

step "failover: tt04 removed, the same name read from the second copy"
mv "$NAS" "$W/nas/tt04-away"
sleep 2
[ "$(read_file tt04)" = 200 ] || fail "no failover to the second copy"
[ "$(sha "$W/body")" = "$SEVENTH" ] || fail "failover served other bytes"

step "with no copy left, 503 (never 404)"
mv "$NAS2" "$W/nas/second-away"
sleep 2
[ "$(read_file tt04)" = 503 ] || fail "no 503 with every copy gone"
kill "$STORE_PID"; wait "$STORE_PID" 2>/dev/null || true; STORE_PID=
mv "$W/nas/tt04-away" "$NAS"; mv "$W/nas/second-away" "$NAS2"

step "every source is as it was"
[ "$(sha "$D/$DAYS/2022-09-07.dbn.zst")" = "$SEVENTH" ] || fail "Data was changed"
[ "$(cat "$T/$DAYS/2022-09-08.dbn.zst")" = "the eighth, version B" ] || fail "tt03 was changed"

echo "rehearsal passed: $n steps (outputs and log in $W)"
